# Copy to .env (git-ignored) and fill in. Never commit real values.

# GitHub API (extract_github): personal access token, read-only public data is enough
GITHUB_TOKEN=

# AWS (S3 raw layer, Glue Data Catalog, Spark jobs)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Snowflake for dbt (key-pair authentication)
DBT_SNOWFLAKE_ACCOUNT=
DBT_SNOWFLAKE_USER=
DBT_SNOWFLAKE_WAREHOUSE=
# Absolute path on the HOST to the private key; mounted read-only into the Airflow containers
DBT_SNOWFLAKE_PRIVATE_KEY_HOST_PATH=

# Environment of the default (dev) Airflow deployment; prod sets its own in docker-compose.yml
PIPELINE_ENV=dev

# Optional: failure alerts as Asana tasks (dags/alerting/asana.py). Leave empty to disable.
ASANA_TOKEN=
# Number after /project/ in the Asana project URL
ASANA_PROJECT_ID=
